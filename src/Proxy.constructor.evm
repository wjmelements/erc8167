// Constructor: delegates[configure(bytes4,address).selector] = new Bootstrap(owner=msg.sender)

// set up delegatecall
0 0 68 0

// address immutable Bootstrap.owner = msg.sender
PUSH12 {prefix: construct src/Bootstrap.evm[:12]} 160
MSTORE(0, OR(CALLER, SHL))
CODECOPY(MSIZE, constructbootstrapsuffix, #constructbootstrapsuffix)
CREATE(0, 0, 135)

// configure(bytes4,address).selector
MSTORE(4, SHL(224, 0x0ee62dbe))
MSTORE(36, DUP1)

GAS DELEGATECALL

#proxy
CODECOPY(0, proxy, DUP1) // TODO: compare to two MSTORE
0 RETURN
{
    constructbootstrapsuffix: construct src/Bootstrap.evm[32:],
    proxy: assemble src/Proxy.evm
}
